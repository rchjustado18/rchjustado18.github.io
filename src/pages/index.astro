---
import "../styles/global.css";

const skills = [
  "WordPress",
  "Elementor",
  "Divi",
  "PHP",
  "Custom Post Types",
  "Advanced Custom Fields",
  "WooCommerce",
  "Shopify",
  "Go High Level",
  "Automations",
  "Google Tag Manager",
  "Google Analytics",
  "CSS",
  "Javascript / jQuery",
  "SEO & Optimization",
  "SVG Animations"
];

const projects = [
  {
    title: "All South Bay Footcare",
    url: "https://www.allsouthbayfootcare.com/",
    image: "/assets/images/allsouthbayfootcare.png",
    categories: ["divi"]
  },
  {
    title: "Direct Dental",
    url: "https://www.dentistinpicorivera.com/",
    image: "/assets/images/dentistinpicorivera.png",
    categories: ["divi"]
  },
  {
    title: "Eazy Foot & Ankle",
    url: "https://eazyfoot.com/",
    image: "/assets/images/eazyfoot.png",
    categories: ["elementor"]
  },
  {
    title: "Lower Mainland Biodiesel",
    url: "https://lowermainlandbiodiesel.com",
    image: "/assets/images/lowermainlandbiodiesel.png",
    categories: ["divi"]
  }
];

const navItems = [
  { label: "Home", href: "#home" },
  { label: "About", href: "#about" },
  { label: "Works", href: "#works" },
  { label: "Contact", href: "#contact" }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Portfolio of Richie Justado, a web developer focused on WordPress, Elementor, Divi, Shopify, automation, analytics, optimization, and SVG animations."
    />
    <title>Richie Justado | Web Developer</title>
    <link rel="icon" type="image/png" href="/assets/images/favicon.png" />
  </head>
  <body>
    <header class="site-header" aria-label="Site header">
      <a class="brand" href="#home" aria-label="Richie Justado home">
        <span class="brand-mark" aria-hidden="true">
          <img src="/assets/images/richie_img.png" alt="" width="44" height="44" />
        </span>
        <span>Richie Justado</span>
      </a>
      <nav class="primary-nav" aria-label="Primary navigation">
        {
          navItems.map((item) => (
            <a href={item.href} data-nav-link>
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main>
      <section class="snap-section hero" id="home" data-section aria-labelledby="home-title">
        <div class="motion-scene hero-scene" aria-hidden="true">
          <svg viewBox="0 0 1200 900" preserveAspectRatio="none">
            <defs>
              <linearGradient id="hero-circuit" x1="0%" x2="100%" y1="0%" y2="100%">
                <stop offset="0%" stop-color="#2fffd0"></stop>
                <stop offset="52%" stop-color="#8bd450"></stop>
                <stop offset="100%" stop-color="#ffb454"></stop>
              </linearGradient>
              <linearGradient id="hero-chip-face" x1="0%" x2="100%" y1="0%" y2="100%">
                <stop offset="0%" stop-color="#1c2530"></stop>
                <stop offset="100%" stop-color="#07090d"></stop>
              </linearGradient>
            </defs>
            <g class="scene-layer scene-layer-slow">
              <path id="hero-signal-a" class="circuit-line" d="M-40 660 H155 V540 H330 V455 H520 V340 H750"></path>
              <path id="hero-signal-b" class="circuit-line muted" d="M55 210 H210 V290 H380 V210 H560 V120 H865 V230"></path>
              <path id="hero-signal-c" class="circuit-line muted" d="M1240 470 H1090 V390 H980"></path>
              <path id="hero-signal-d" class="circuit-line" d="M620 820 V705 H720 V575 H845 V400"></path>
              <circle class="signal-dot" r="9">
                <animateMotion dur="8s" begin="0s" repeatCount="indefinite" rotate="auto">
                  <mpath href="#hero-signal-a"></mpath>
                </animateMotion>
              </circle>
              <circle class="signal-dot" r="9">
                <animateMotion dur="9s" begin="-2.2s" repeatCount="indefinite" rotate="auto">
                  <mpath href="#hero-signal-b"></mpath>
                </animateMotion>
              </circle>
              <circle class="signal-dot" r="9">
                <animateMotion dur="8.5s" begin="-4.1s" repeatCount="indefinite" rotate="auto">
                  <mpath href="#hero-signal-c"></mpath>
                </animateMotion>
              </circle>
              <circle class="signal-dot" r="9">
                <animateMotion dur="7.5s" begin="-5.6s" repeatCount="indefinite" rotate="auto">
                  <mpath href="#hero-signal-d"></mpath>
                </animateMotion>
              </circle>
            </g>
            <g class="scene-layer scene-layer-fast">
              <rect class="scene-chip large-chip" x="750" y="230" width="230" height="170" rx="14"></rect>
              <path class="chip-pins" d="M724 258 H750 M724 292 H750 M724 326 H750 M724 360 H750"></path>
              <path class="chip-pins" d="M980 258 H1008 M980 292 H1008 M980 326 H1008 M980 360 H1008"></path>
            </g>
          </svg>
        </div>

        <div class="section-inner hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">Portfolio</p>
            <h1 id="home-title">Richie Justado</h1>
            <p class="hero-role">Web Developer & Automation Builder</p>
            <p class="hero-summary">
              I build polished, conversion-focused websites with practical automation, analytics.
            </p>
            <div class="hero-actions" aria-label="Portfolio actions">
              <a class="button button-primary" href="#works">View Works</a>
              <a class="button button-secondary" href="mailto:rchjustado@gmail.com">Email Me</a>
            </div>
          </div>

          <div class="hero-visual" aria-label="Technology system illustration">
            <div class="chip-panel">
              <img
                class="chip-photo"
                src="/assets/images/motherboard-background.jpg"
                alt=""
                width="2048"
                height="921"
              />
              <svg class="processor-svg" viewBox="0 0 520 520" role="img" aria-labelledby="processor-title">
                <title id="processor-title">Realistic processor chip and circuit illustration</title>
                <defs>
                  <linearGradient id="processor-package" x1="0%" x2="100%" y1="0%" y2="100%">
                    <stop offset="0%" stop-color="#eff8ff"></stop>
                    <stop offset="18%" stop-color="#7f9bab"></stop>
                    <stop offset="48%" stop-color="#1a2630"></stop>
                    <stop offset="72%" stop-color="#0b1117"></stop>
                    <stop offset="100%" stop-color="#e4f0f8"></stop>
                  </linearGradient>
                  <linearGradient id="processor-plate" x1="12%" x2="88%" y1="0%" y2="100%">
                    <stop offset="0%" stop-color="#f7fbff"></stop>
                    <stop offset="32%" stop-color="#a7c3d3"></stop>
                    <stop offset="64%" stop-color="#253542"></stop>
                    <stop offset="100%" stop-color="#061019"></stop>
                  </linearGradient>
                  <linearGradient id="processor-core" x1="0%" x2="100%" y1="0%" y2="100%">
                    <stop offset="0%" stop-color="#1fc78f"></stop>
                    <stop offset="42%" stop-color="#08281d"></stop>
                    <stop offset="100%" stop-color="#010706"></stop>
                  </linearGradient>
                  <pattern id="processor-pad-grid" width="10" height="10" patternUnits="userSpaceOnUse">
                    <rect width="10" height="10" fill="#132b24"></rect>
                    <circle cx="5" cy="5" r="2.5" fill="#b8ffd0" opacity="0.9"></circle>
                  </pattern>
                  <radialGradient id="processor-glow" cx="50%" cy="50%" r="55%">
                    <stop offset="0%" stop-color="#2fffd0" stop-opacity="0.46"></stop>
                    <stop offset="70%" stop-color="#2fffd0" stop-opacity="0.08"></stop>
                    <stop offset="100%" stop-color="#2fffd0" stop-opacity="0"></stop>
                  </radialGradient>
                  <filter id="processor-shadow" x="-20%" y="-20%" width="140%" height="150%">
                    <feDropShadow dx="0" dy="20" stdDeviation="18" flood-color="#000000" flood-opacity="0.55"></feDropShadow>
                    <feDropShadow dx="0" dy="0" stdDeviation="12" flood-color="#2fffd0" flood-opacity="0.18"></feDropShadow>
                  </filter>
                </defs>
                <rect class="board-haze" x="0" y="0" width="520" height="520" rx="18"></rect>
                <g class="board-grid">
                  <path id="chip-signal-a" d="M34 124 H120 V90 H236 V150"></path>
                  <path id="chip-signal-b" d="M36 390 H135 V336 H150"></path>
                  <path id="chip-signal-c" d="M486 126 H400 V178 H370"></path>
                  <path id="chip-signal-d" d="M486 394 H394 V344 H370"></path>
                  <path d="M70 260 H150"></path>
                  <path d="M370 260 H474"></path>
                  <path d="M260 44 V150"></path>
                  <path d="M260 370 V472"></path>
                </g>
                <g class="board-vias">
                  <circle cx="34" cy="124" r="5"></circle>
                  <circle cx="120" cy="90" r="5"></circle>
                  <circle cx="236" cy="150" r="5"></circle>
                  <circle cx="36" cy="390" r="5"></circle>
                  <circle cx="135" cy="336" r="5"></circle>
                  <circle cx="150" cy="336" r="5"></circle>
                  <circle cx="486" cy="126" r="5"></circle>
                  <circle cx="400" cy="178" r="5"></circle>
                  <circle cx="370" cy="178" r="5"></circle>
                  <circle cx="486" cy="394" r="5"></circle>
                  <circle cx="394" cy="344" r="5"></circle>
                  <circle cx="370" cy="344" r="5"></circle>
                  <circle cx="70" cy="260" r="5"></circle>
                  <circle cx="474" cy="260" r="5"></circle>
                  <circle cx="260" cy="44" r="5"></circle>
                  <circle cx="260" cy="472" r="5"></circle>
                </g>
                <ellipse class="processor-backlight" cx="260" cy="260" rx="170" ry="150"></ellipse>
                <g class="processor-package" filter="url(#processor-shadow)">
                  <rect class="chip-substrate" x="128" y="128" width="264" height="264" rx="18"></rect>
                  <path class="pins pins-left" d="M98 166 H128 M98 194 H128 M98 222 H128 M98 250 H128 M98 278 H128 M98 306 H128 M98 334 H128 M98 362 H128"></path>
                  <path class="pins pins-right" d="M392 166 H422 M392 194 H422 M392 222 H422 M392 250 H422 M392 278 H422 M392 306 H422 M392 334 H422 M392 362 H422"></path>
                  <path class="pins pins-top" d="M166 98 V128 M194 98 V128 M222 98 V128 M250 98 V128 M278 98 V128 M306 98 V128 M334 98 V128 M362 98 V128"></path>
                  <path class="pins pins-bottom" d="M166 392 V422 M194 392 V422 M222 392 V422 M250 392 V422 M278 392 V422 M306 392 V422 M334 392 V422 M362 392 V422"></path>
                  <rect class="chip-shell" x="148" y="148" width="224" height="224" rx="14"></rect>
                  <path class="chip-bevel chip-bevel-top" d="M148 148 H372 L350 170 H170 Z"></path>
                  <path class="chip-bevel chip-bevel-bottom" d="M170 350 H350 L372 372 H148 Z"></path>
                  <rect class="chip-plate" x="168" y="168" width="184" height="184" rx="10"></rect>
                  <rect class="chip-pad-field" x="187" y="187" width="146" height="146" rx="7"></rect>
                  <rect class="chip-core" x="224" y="224" width="72" height="72" rx="5"></rect>
                  <g class="core-grid">
                    <path d="M238 242 H282 M238 260 H282 M238 278 H282"></path>
                    <path d="M242 238 V282 M260 238 V282 M278 238 V282"></path>
                  </g>
                  <path class="chip-reflection" d="M174 174 H346 L318 202 H202 Z"></path>
                </g>
              </svg>
            </div>
            <div class="hero-facts" aria-label="Portfolio highlights">
              <span><strong>6+</strong> years experience</span>
              <span><strong>4</strong> featured works</span>
            </div>
          </div>
        </div>
      </section>

      <section class="snap-section about" id="about" data-section aria-labelledby="about-title">
        <div class="section-inner about-grid">
          <div class="about-media">
            <img
              src="/assets/images/about-img.jpeg"
              alt="Developer working on website code"
              width="1126"
              height="750"
            />
          </div>
          <div class="about-copy">
            <p class="eyebrow">Personal Profile</p>
            <h2 id="about-title">Personal Profile</h2>
            <p>
              I am a Web Developer with 6+ years of experience creating fast, reliable websites for
              service businesses, ecommerce brands, and lead-generation campaigns. My work combines
              WordPress builders like Elementor and Divi with PHP, custom post types, WooCommerce,
              Shopify, SVG animations, website optimization, and SEO.
            </p>
            <p>
              I also help connect the marketing side of a site: Go High Level, automations, Google
              Tag Manager, and Google Analytics, so the build is easier to launch, track, and improve.
            </p>
            <ul class="skill-list" aria-label="Skills">
              {skills.map((skill) => <li>{skill}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <section class="snap-section works" id="works" data-section aria-labelledby="works-title">
        <div class="section-inner works-inner">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Selected Projects</p>
              <h2 id="works-title">Works</h2>
            </div>
            <p class="section-lede">
              A focused set of recent WordPress builds across Divi and Elementor.
            </p>
          </div>

          <div class="filter-bar" role="group" aria-label="Filter works">
            <button class="filter-button active" type="button" data-filter-button="all" aria-pressed="true">
              All
            </button>
            <button class="filter-button" type="button" data-filter-button="divi" aria-pressed="false">
              Divi
            </button>
            <button class="filter-button" type="button" data-filter-button="elementor" aria-pressed="false">
              Elementor
            </button>
          </div>

          <div class="project-grid">
            {
              projects.map((project) => (
                <article class="project-card" data-project-card data-categories={project.categories.join(" ")}>
                  <a href={project.url} target="_blank" rel="noreferrer">
                    <span class="browser-frame">
                      <span class="frame-top" aria-hidden="true">
                        <span></span>
                        <span></span>
                        <span></span>
                      </span>
                      <img src={project.image} alt={`${project.title} website screenshot`} />
                    </span>
                    <span class="project-info">
                      <span class="project-title">{project.title}</span>
                      <span class="project-tags">{project.categories.join(" / ")}</span>
                    </span>
                  </a>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="snap-section contact" id="contact" data-section aria-labelledby="contact-title">
        <div class="motion-scene contact-scene" aria-hidden="true">
          <svg viewBox="0 0 1200 900" preserveAspectRatio="none">
            <defs>
              <linearGradient id="contact-circuit" x1="0%" x2="100%" y1="0%" y2="100%">
                <stop offset="0%" stop-color="#2fffd0"></stop>
                <stop offset="55%" stop-color="#ffb454"></stop>
                <stop offset="100%" stop-color="#ff6b5f"></stop>
              </linearGradient>
            </defs>
            <g class="scene-layer scene-layer-slow">
              <path class="circuit-line" d="M-70 690 H160 V590 H330 V470 H555 V360 H720"></path>
              <path class="circuit-line muted" d="M120 820 H350 V735 H540 V655 H790 V545 H1230"></path>
              <path class="circuit-line muted" d="M610 165 H780 V260 H980 V210 H1270"></path>
            </g>
            <g class="scene-layer scene-layer-fast">
              <rect class="scene-chip contact-chip" x="790" y="330" width="250" height="170" rx="14"></rect>
              <path class="chip-pins" d="M760 365 H790 M760 400 H790 M760 435 H790 M1040 365 H1070 M1040 400 H1070 M1040 435 H1070"></path>
              <path id="contact-signal-path" class="signal-track" d="M255 625 H430 V535 H590 V430 H790"></path>
            </g>
          </svg>
        </div>
        <div class="section-inner contact-grid">
          <div>
            <p class="eyebrow">Contact</p>
            <h2 id="contact-title">Let's Build Something Better</h2>
            <p class="contact-copy">
              Send the project details, the site goal, or the workflow you want to improve. I can
              help turn it into a cleaner website, a better funnel, or a more measurable launch.
            </p>
          </div>
          <div class="contact-details">
            <a class="contact-link" href="mailto:rchjustado@gmail.com">
              <span>Email</span>
              <strong>rchjustado@gmail.com</strong>
            </a>
          </div>
        </div>
      </section>
    </main>

    <script is:inline>
      const filterButtons = document.querySelectorAll("[data-filter-button]");
      const projectCards = document.querySelectorAll("[data-project-card]");

      filterButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const filter = button.dataset.filterButton;

          filterButtons.forEach((item) => {
            const isActive = item === button;
            item.classList.toggle("active", isActive);
            item.setAttribute("aria-pressed", String(isActive));
          });

          projectCards.forEach((card) => {
            const categories = card.dataset.categories.split(" ");
            const isVisible = filter === "all" || categories.includes(filter);
            card.classList.toggle("is-hidden", !isVisible);
          });
        });
      });

      const navLinks = document.querySelectorAll("[data-nav-link]");
      const sections = document.querySelectorAll("[data-section]");
      const root = document.documentElement;

      window.addEventListener(
        "pointermove",
        (event) => {
          const x = event.clientX / window.innerWidth - 0.5;
          const y = event.clientY / window.innerHeight - 0.5;
          root.style.setProperty("--motion-x", x.toFixed(3));
          root.style.setProperty("--motion-y", y.toFixed(3));
        },
        { passive: true }
      );

      const setActiveNav = (id) => {
        navLinks.forEach((link) => {
          link.classList.toggle("active", link.getAttribute("href") === `#${id}`);
        });
      };

      let ticking = false;
      const updateActiveFromScroll = () => {
        const marker = window.innerHeight * 0.42;
        let activeId = sections[0]?.id || "home";

        sections.forEach((section) => {
          const rect = section.getBoundingClientRect();
          if (rect.top <= marker && rect.bottom >= marker) {
            activeId = section.id;
          }
        });

        setActiveNav(activeId);
        ticking = false;
      };

      window.addEventListener(
        "scroll",
        () => {
          if (ticking) {
            return;
          }

          ticking = true;
          window.requestAnimationFrame(updateActiveFromScroll);
        },
        { passive: true }
      );

      setActiveNav(window.location.hash.replace("#", "") || "home");

      window.addEventListener("load", () => {
        if (!window.location.hash) {
          updateActiveFromScroll();
          return;
        }

        const target = document.querySelector(window.location.hash);
        target?.scrollIntoView({ block: "start" });
        window.setTimeout(updateActiveFromScroll, 120);
      });
    </script>
  </body>
</html>
